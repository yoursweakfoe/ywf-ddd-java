<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yoursweakfoe.application</groupId>
        <artifactId>sample-service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>sample-service-contract</artifactId>
    <name>sample-service-contract</name>
    <description>公开契约 jar —— 服务接口契约、Command/Query、CO、东西向 proto（消费方唯一依赖）</description>

    <dependencies>
        <!-- CQRS 标记接口（Command / Query / Event） -->
        <dependency>
            <groupId>com.yoursweakfoe</groupId>
            <artifactId>common-contract</artifactId>
        </dependency>

        <!-- proto 生成代码依赖（grpc stub / protobuf 运行时，版本由 Boot dependency management 托管） -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- proto → Java：版本与执行配置由 spring-boot-starter-parent 托管（protoc + grpc 代码生成开箱即用） -->
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
