# ============================================================================
# IDE 本地开发专用环境变量（供 IDEA Run Configuration → EnvFile 导入）
# ----------------------------------------------------------------------------
# 用法（IntelliJ IDEA）：
#   Run/Debug Configurations → 选中 Spring Boot 启动项
#   → 勾选 "Enable EnvFile"（需安装 EnvFile 插件）或使用 "Environment variables"
#   → 选中本文件 ide-dev.env
#
# 前置依赖（只在启用 OTel Agent 时需要，模式 A 可忽略）：
#   VM options 追加：-javaagent:<项目绝对路径>/service/lib/opentelemetry-javaagent.jar
#   jar 下载：mkdir -p lib && curl -L -o lib/opentelemetry-javaagent.jar
#             https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/latest/download/opentelemetry-javaagent.jar
#
# 三种模式切换方式：按需取消/添加 # 注释即可
# ============================================================================


# ---------- 基础：Spring Profile ----------
SPRING_PROFILES_ACTIVE=dev


# ============================================================================
# 模式 A【默认启用】纯日志，不上报任何遥测（最干净）
#   Agent 仍注入 trace_id/span_id 到日志 MDC，可用 grep <trace_id> 串联请求
#   无需任何外部基础设施
# ============================================================================
OTEL_SERVICE_NAME=service-local
OTEL_TRACES_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_INSTRUMENTATION_LOGBACK_MDC_ENABLED=true


# ============================================================================
# 模式 B｜接入阿里云 ARMS（生产级链路追踪）
#   - 在 ARMS 控制台获取接入点：<region>-arms.aliyuncs.com:8090
#   - 显式指定 grpc 协议
#   - 把模式 A 注释掉，取消下面注释即可
# ============================================================================
# OTEL_SERVICE_NAME=service
# OTEL_TRACES_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=none
# OTEL_METRICS_EXPORTER=none
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_ENDPOINT=https://<region>-arms.aliyuncs.com:8090
# OTEL_INSTRUMENTATION_LOGBACK_MDC_ENABLED=true
# OTEL_TRACES_SAMPLER=parentbased_always_on


# ============================================================================
# 模式 C｜接入本机 Jaeger（本地联调链路追踪）
#   - IDE 进程跑在宿主机，Jaeger 容器已 -p 4317:4317 发布端口
#   - Jaeger UI: http://localhost:16686
# ============================================================================
# OTEL_SERVICE_NAME=service-local
# OTEL_TRACES_EXPORTER=otlp
# OTEL_LOGS_EXPORTER=none
# OTEL_METRICS_EXPORTER=none
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_INSTRUMENTATION_LOGBACK_MDC_ENABLED=true
# OTEL_TRACES_SAMPLER=parentbased_always_on


# ============================================================================
# 模式 D｜调试观察 span（直接打印到控制台，不依赖任何后端）
# ============================================================================
# OTEL_SERVICE_NAME=service-local
# OTEL_TRACES_EXPORTER=console
# OTEL_LOGS_EXPORTER=none
# OTEL_METRICS_EXPORTER=none
# OTEL_INSTRUMENTATION_LOGBACK_MDC_ENABLED=true
