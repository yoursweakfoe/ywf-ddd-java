<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yoursweakfoe</groupId>
        <artifactId>ywf-ddd-common</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>common-security</artifactId>
    <description>身份上下文模块 - REST 边界解析网关 Header，构建带来源标记的 SecurityContext（opt-in）</description>

    <dependencies>
        <!-- Spring Security（core + config + web：SecurityContext + SecurityFilterChain + @PreAuthorize）
             spring-security-web 必须保留：Boot 4 的 ServletWebSecurityAutoConfiguration
             在 servlet web 应用下会内省 WebSecurityConfiguration，缺失 SecurityFilterChain 类将导致启动失败 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Boot 自动装配（@AutoConfiguration / 条件注解 / Filter Bean 注册） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- spring-web（OncePerRequestFilter；optional：非 Web 服务无需） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Jakarta Servlet API（Filter 编译期签名，运行时由 Web 容器提供） -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ========== 测试 ========== -->
        <dependency>
            <groupId>com.yoursweakfoe</groupId>
            <artifactId>common-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
