<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yoursweakfoe</groupId>
        <artifactId>ywf-ddd-common</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>common-ddd</artifactId>
    <description>DDD 框架 - 领域模型、CQRS 契约、MyBatis 仓储实现（手写 XML）、乐观锁</description>

    <dependencies>
        <!-- CQRS 契约标记接口（Command / Query / CO / IntegrationEvent） -->
        <dependency>
            <groupId>com.yoursweakfoe</groupId>
            <artifactId>common-contract</artifactId>
        </dependency>
        <!-- 统一异常体系（BusinessException） -->
        <dependency>
            <groupId>com.yoursweakfoe</groupId>
            <artifactId>common-exception</artifactId>
        </dependency>

        <!-- ========== 领域层 ========== -->

        <!-- JUG（java-uuid-generator）：RFC 9562 UUIDv7 生成（聚合身份铸造）。
             纯工具库零传递依赖；版本经父 pom dependencyManagement 统一管理 -->
        <dependency>
            <groupId>com.fasterxml.uuid</groupId>
            <artifactId>java-uuid-generator</artifactId>
        </dependency>

        <!-- ========== 基础设施层 ========== -->
        <!-- MyBatis（纯 MyBatis + 手写 XML SQL；starter 传递 mybatis / mybatis-spring / spring-boot-starter-jdbc） -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>

        <!-- 多数据源（@DS 注解切换，底层 HikariCP）：
             MybatisPersistence 多数据源路由兼容验证；消费方多数据源推荐项（独立模块，非 MP 一部分） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>dynamic-datasource-spring-boot4-starter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ========== 测试 ========== -->
        <dependency>
            <groupId>com.yoursweakfoe</groupId>
            <artifactId>common-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- common-pg：MybatisPersistenceTest 的 removeDomain* 用例需要 UUIDTypeHandler 注册
             （common-pg 不依赖 common-ddd，无循环依赖；test scope 不传递给消费方） -->
        <dependency>
            <groupId>com.yoursweakfoe</groupId>
            <artifactId>common-pg</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- H2 内存数据库（MybatisPersistenceTest 用） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
