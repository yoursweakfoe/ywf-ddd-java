<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yoursweakfoe</groupId>
        <artifactId>ywf-ddd-common</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>common-ddd</artifactId>
    <description>DDD 框架 - 领域模型、CQRS 契约、MyBatis-Plus 仓储实现、领域事件、乐观锁</description>

    <dependencies>
        <!-- CQRS 契约标记接口（Command / Query / Event） -->
        <dependency>
            <groupId>com.yoursweakfoe</groupId>
            <artifactId>common-contract</artifactId>
        </dependency>
        <!-- 统一异常体系（BusinessException） -->
        <dependency>
            <groupId>com.yoursweakfoe</groupId>
            <artifactId>common-exception</artifactId>
        </dependency>

        <!-- ========== 领域层 ========== -->

        <!-- ========== 基础设施层 ========== -->
        <!-- MyBatis-Plus（Boot 4 专用 starter） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <!-- 多数据源（@DS 注解切换，底层 HikariCP）：
             框架源码不直接使用，仅测试环境验证 MybatisPersistence 在多数据源下的兼容性。
             消费方需多数据源时自行引入（依赖最小化，见 .agents/rules/04-forbidden-patterns.md） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>dynamic-datasource-spring-boot4-starter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ========== 测试 ========== -->
        <dependency>
            <groupId>com.yoursweakfoe</groupId>
            <artifactId>common-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Jackson（测试 fixtures 中 JSON 序列化用） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- H2 内存数据库（MybatisPersistenceTest 用） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
