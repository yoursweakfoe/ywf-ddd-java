<?xml version="1.0" encoding="UTF-8"?>
<!--
    统一日志配置（纯控制台输出）

    本配置通过 common-observability jar 自动被所有引入的业务模块继承。
    业务模块无需再在自己的 resources 下定义 logback-spring.xml。

    分档策略（通过 spring.profiles.active 自动切换）：
      - dev ：控制台彩色（DEBUG），本地快速反馈
      - test：控制台彩色（INFO），容器 stdout
      - prod：控制台 JSON（INFO），结构化 stdout，等待对接日志采集系统

    说明：
      当前未引入日志采集系统（阿里云 SLS / Loki / ELK 均未部署），
      且运行环境为 Docker 容器，日志输出到 stdout 后可由
      `docker logs` / `docker-compose logs` 直接查看，
      未来接入采集系统时只需：
        - Docker 宿主：配置 logging-driver（fluentd/json-file/gelf 等）
        - K8s：节点 DaemonSet（Logtail/Fluent Bit）采集容器 stdout
      应用侧零改动。

    可观测性（零侵入方案）：
      - 链路追踪由 OpenTelemetry Java Agent（-javaagent:/app/otel-javaagent.jar）接入
      - Agent 自动向 SLF4J MDC 注入标准 key：trace_id / span_id / trace_flags
      - 未挂 Agent 时 MDC 为空，pattern 使用 `:-` 兜底显示空串，不影响本地调试
      - 未来对接 Jaeger / Tempo / Datadog 只需设 OTEL_EXPORTER_OTLP_ENDPOINT，应用零改动

    统一能力：
      - LevelChangePropagator 让 java.util.logging 级别与 SLF4J 联动，消除 JUL 性能损耗
      - scan=true 运行时热加载（默认 60s）
-->
<configuration scan="true" scanPeriod="60 seconds">

    <!-- JUL → SLF4J 级别联动（性能优化，prod 收益明显） -->
    <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
        <resetJUL>true</resetJUL>
    </contextListener>

    <!-- Spring Boot 默认 CONSOLE 彩色布局相关变量 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="app"/>

    <!-- ============ 公共 pattern ============ -->
    <!-- 彩色人类可读（dev/test 控制台）；trace_id/span_id 由 OpenTelemetry Java Agent 自动注入 MDC，未挂 Agent 时显示为空 -->
    <property name="HUMAN_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%-5level) %clr([${APP_NAME},%X{trace_id:-},%X{span_id:-}]){cyan} %clr([%thread]){magenta} %clr(%-40.40logger{39}){cyan} : %msg%n%wEx"/>
    <!-- 结构化 JSON（prod 控制台）；手工拼装无需 logstash-encoder 依赖 -->
    <!-- 转义顺序：\ → " → 换行 → 回车（先转义反斜杠，避免后续引入的 \ 被二次转义） -->
    <property name="JSON_LOG_PATTERN"
              value='{"ts":"%d{yyyy-MM-dd HH:mm:ss.SSS}","lvl":"%level","app":"${APP_NAME}","trace_id":"%X{trace_id:-}","span_id":"%X{span_id:-}","thread":"%thread","logger":"%logger","msg":"%replace(%replace(%replace(%replace(%msg){&apos;\\&apos;,&apos;\\\\&apos;}){&apos;&quot;&apos;,&apos;\\&quot;&apos;}){&apos;\n&apos;,&apos;\\n&apos;}){&apos;\r&apos;,&apos;\\r&apos;}","ex":"%replace(%replace(%replace(%replace(%rEx){&apos;\\&apos;,&apos;\\\\&apos;}){&apos;&quot;&apos;,&apos;\\&quot;&apos;}){&apos;\n&apos;,&apos;\\n&apos;}){&apos;\r&apos;,&apos;\\r&apos;}"}%n'/>

    <!-- ========================= dev：控制台彩色 DEBUG ========================= -->
    <springProfile name="dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${HUMAN_LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <logger name="com.yoursweakfoe" level="DEBUG"/>
        <logger name="io.grpc" level="WARN"/>
        <logger name="org.apache.seata" level="WARN"/>
        <logger name="org.mybatis" level="WARN"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ========================= test：控制台彩色 INFO ========================= -->
    <springProfile name="test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${HUMAN_LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <logger name="com.yoursweakfoe" level="INFO"/>
        <logger name="io.grpc" level="WARN"/>
        <logger name="org.apache.seata" level="WARN"/>
        <logger name="org.mybatis" level="WARN"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ========================= prod：控制台 JSON INFO ========================= -->
    <springProfile name="prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${JSON_LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <logger name="com.yoursweakfoe" level="INFO"/>
        <logger name="io.grpc" level="WARN"/>
        <logger name="org.apache.seata" level="WARN"/>
        <logger name="org.mybatis" level="ERROR"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ========================= 兜底：非 dev/test/prod 时使用人类可读格式 ========================= -->
    <springProfile name="!dev &amp; !test &amp; !prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${HUMAN_LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <logger name="com.yoursweakfoe" level="INFO"/>
        <logger name="io.grpc" level="WARN"/>
        <logger name="org.apache.seata" level="WARN"/>
        <logger name="org.mybatis" level="WARN"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
